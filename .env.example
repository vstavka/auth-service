APP_NAME=auth-service
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_PORT=8000

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

LOGGING_LEVEL=INFO
LOGGING_PATH=
LOGGING_SLOW_REQUEST_THRESHOLD_SECONDS=3.0

CACHE_BACKEND=memory
CACHE_ACCOUNT_TTL_SECONDS=60
CACHE_SESSIONS_TTL_SECONDS=60

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

EVENTS_PUBLISHER=memory
EVENTS_FILE_PATH=events.jsonl
EVENTS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EVENTS_KAFKA_CLIENT_ID=auth-service-outbox
EVENTS_RELAY_POLL_INTERVAL_SECONDS=1
EVENTS_RELAY_BATCH_SIZE=50

GRPC_ENABLED=true
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
